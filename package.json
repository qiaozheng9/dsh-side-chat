{
  "name": "dsh-side-chat",
  "version": "0.1.10",
  "description": "Standalone Codex-style /side conversations for DSH",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.8.0",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ],
      "platform": "web"
    },
    "manifestVersion": 1
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --maxWorkers=1",
    "lint": "eslint .",
    "test:browser": "node scripts/verify-browser.mjs",
    "test:mount": "playwright test --config playwright.config.ts",
    "check:consumer-types": "tsc --noEmit --module esnext --moduleResolution bundler --target es2023 --jsx react-jsx --skipLibCheck tests/consumer.ts"
  },
  "dependencies": {
    "fflate": "0.8.2",
    "ws": "^8.18.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-agent": "^0.2.1-rc.1",
    "@deepseek-ai/dsh-client-locale": "^0.2.1-rc.1",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.2.1-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.2.1-rc.1",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "^0.2.1-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.1-rc.1",
    "@deepseek-ai/dsh-host-webserver": "^0.2.1-rc.1",
    "@deepseek-ai/dsh-llm": "^0.2.1-rc.1",
    "@deepseek-ai/dsh-session": "^0.2.1-rc.1",
    "@deepseek-ai/dsh-subagent": "^0.2.1-rc.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@cordisjs/plugin-loader": "^1.0.0-rc.5",
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/cordis-plugin-group": "1.0.5",
    "@deepseek-ai/cordis-plugin-include": "1.0.10",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.1",
    "@deepseek-ai/dsh-agent-loop": "0.2.1-rc.1",
    "@deepseek-ai/dsh-attachment": "0.2.1-rc.1",
    "@deepseek-ai/dsh-client-locale": "0.2.1-rc.1",
    "@deepseek-ai/dsh-client-store": "0.2.1-rc.1",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.1-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.1-rc.1",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "0.2.1-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.1",
    "@deepseek-ai/dsh-host-webserver": "0.2.1-rc.1",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.1",
    "@deepseek-ai/dsh-ptc-runtime": "0.2.1-rc.1",
    "@deepseek-ai/dsh-sandbox": "0.2.1-rc.1",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.1-rc.1",
    "@deepseek-ai/dsh-scope": "0.2.1-rc.1",
    "@deepseek-ai/dsh-session": "0.2.1-rc.1",
    "@deepseek-ai/dsh-session-persistence": "0.2.1-rc.1",
    "@deepseek-ai/dsh-session-projection": "0.2.1-rc.1",
    "@deepseek-ai/dsh-settings": "0.2.1-rc.1",
    "@deepseek-ai/dsh-subagent": "0.2.1-rc.1",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.1",
    "@deepseek-ai/dsh-user-approval": "0.2.1-rc.1",
    "@deepseek-ai/dsh-util-code-language": "0.2.1-rc.1",
    "@deepseek-ai/dsh-util-time": "0.2.1-rc.1",
    "@deepseek-ai/dsh-util-workspace-path": "0.2.1-rc.1",
    "@deepseek-ai/dsh-working-directory": "0.2.1-rc.1",
    "@deepseek-ai/schemastery": "~3.18.5",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@shikijs/langs": "^4.3.1",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.0.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.1",
    "@types/ws": "^8.5.10",
    "anser": "^2.3.5",
    "clsx": "^2.1.1",
    "cordis": "^4.0.0-rc.8",
    "diff": "^9.0.0",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "immer": "^10.1.1",
    "jsdom": "^29.1.1",
    "katex": "^0.16.47",
    "lightningcss": "^1.32.0",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-math": "^3.0.0",
    "micromark-core-commonmark": "^2.0.3",
    "micromark-extension-gfm": "^3.0.0",
    "micromark-extension-math": "^3.1.0",
    "micromark-factory-space": "^2.0.1",
    "micromark-util-character": "^2.1.1",
    "micromark-util-classify-character": "^2.0.1",
    "micromark-util-sanitize-uri": "^2.0.1",
    "micromark-util-symbol": "^2.0.1",
    "micromark-util-types": "^2.0.2",
    "react": "^18.2.0",
    "react-dom": "18.2.0",
    "rxjs": "^7.8.2",
    "shiki": "^4.3.1",
    "tsdown": "^0.22.2",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.8",
    "yaml": "^2.9.1",
    "zustand": "~4.4.7"
  }
}
